{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/coach-refresh",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/weekly-social-report",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/owner-story-weekly",
      "schedule": "15 13 * * 1"
    },
    {
      "path": "/api/cron/office-post-announcements",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "app/**/*.{js,ts,tsx}": {
      "maxDuration": 300
    }
  }
}
