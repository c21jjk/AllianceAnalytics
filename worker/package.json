{
  "name": "alliance-reel-render-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted MP4 render worker for AllianceAnalytics Reels (Fabric + ffmpeg on Fly.io).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "playwright": "1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
